# Local Cloudflare Workers preview only. Copy to .dev.vars and keep real values uncommitted.
NEXTJS_ENV=development
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_GENITHM_API_URL=http://localhost:8000
GENITHM_APP_URL=http://localhost:8787

# V49 server-only AI providers. Never use NEXT_PUBLIC_ for these secrets.
GEMINI_API_KEY=
GROQ_API_KEY=
GENITHM_GEMINI_MODEL=gemini-3.8-flash
GENITHM_GROQ_MODEL=llama-3.3-70b-versatile
GENITHM_AI_FIRST_OUTPUT_TIMEOUT_MS=8000
GENITHM_AI_STREAM_IDLE_TIMEOUT_MS=15000
GENITHM_AI_TOTAL_TIMEOUT_MS=60000
# Optional: GENITHM_GEMINI_REASONING_EFFORT=medium
