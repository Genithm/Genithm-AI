# Safe client-side Supabase values. Do not put secret/service-role keys in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# API
GENITHM_ENV=development
GENITHM_API_ALLOWED_ORIGINS=http://localhost:3000
# The API readiness endpoint reuses the backend-only Supabase URL/secret below.
# In production, readiness returns HTTP 503 if those credentials are not configured.
GENITHM_API_READINESS_TIMEOUT_SECONDS=3

# Worker runtime — server/deployment environment only.
# NEVER prefix secret keys with NEXT_PUBLIC_ and never commit real secrets.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Deterministic sequence validation worker
GENITHM_SEQUENCE_VISIBILITY_SECONDS=300
GENITHM_SEQUENCE_MAX_ATTEMPTS=3
GENITHM_SEQUENCE_POLL_SECONDS=2

# NCBI scientific source worker
NCBI_TOOL=genithm
NCBI_EMAIL=developer-contact@example.com
# Optional. Keep backend-only. NCBI permits higher request throughput with an API key.
NCBI_API_KEY=
GENITHM_NCBI_VISIBILITY_SECONDS=300
GENITHM_NCBI_MAX_ATTEMPTS=3
GENITHM_NCBI_POLL_SECONDS=2

# NCBI BLAST worker
# Uses the same NCBI_TOOL/NCBI_EMAIL identity above. Deploy as a separate non-root worker.
GENITHM_BLAST_VISIBILITY_SECONDS=300
GENITHM_BLAST_POLL_SECONDS=2

# Generic deterministic scientific worker (Pairwise Alignment V1)
GENITHM_SCIENTIFIC_VISIBILITY_SECONDS=300
GENITHM_SCIENTIFIC_MAX_ATTEMPTS=3
GENITHM_SCIENTIFIC_POLL_SECONDS=2

# Tamper-evident audit checkpoint signer
# Generate a dedicated 32-byte Ed25519 private seed in a secrets manager. Never commit it or expose it to browsers.
GENITHM_AUDIT_SIGNING_KEY_ID=audit-ed25519-prod-v1
GENITHM_AUDIT_SIGNING_PRIVATE_KEY_BASE64=REPLACE_IN_SECRET_MANAGER_ONLY
GENITHM_AUDIT_VISIBILITY_SECONDS=300
GENITHM_AUDIT_POLL_SECONDS=2
