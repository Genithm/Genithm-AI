# Safe client-side Supabase values. Do not put secret/service-role keys in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# API
GENITHM_ENV=development
GENITHM_API_ALLOWED_ORIGINS=http://localhost:3000

# Sequence validation worker — server/deployment environment only.
# NEVER prefix the secret key with NEXT_PUBLIC_ and never commit a real secret.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
GENITHM_SEQUENCE_VISIBILITY_SECONDS=300
GENITHM_SEQUENCE_MAX_ATTEMPTS=3
GENITHM_SEQUENCE_POLL_SECONDS=2
