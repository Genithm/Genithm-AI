# Safe client-side Supabase values. Do not put secret/service-role keys in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# API
GENITHM_ENV=development
GENITHM_API_ALLOWED_ORIGINS=http://localhost:3000
GENITHM_API_READINESS_TIMEOUT_SECONDS=3

# Worker/runtime and server-only values.
# NEVER prefix secret keys with NEXT_PUBLIC_ and never commit real secrets.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# One-time first Platform Admin activation target. Set this only in server/deployment
# configuration after the intended operator has created a Genithm account. It must
# be that auth user's UUID; never expose it through NEXT_PUBLIC_*.
GENITHM_BOOTSTRAP_ADMIN_USER_ID=

# Canonical deployed web origin used for payment-provider return URLs.
GENITHM_APP_URL=http://localhost:3000

# Stripe — customer checkout/subscriptions/portal/invoices/refunds/disputes + payout status.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# PayPal — customer checkout and recurring subscriptions.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=REPLACE_IN_SECRET_MANAGER_ONLY
PAYPAL_CLIENT_SECRET=REPLACE_IN_SECRET_MANAGER_ONLY
# ID of the PayPal webhook registered to https://YOUR_APP/api/billing/paypal/webhook
PAYPAL_WEBHOOK_ID=REPLACE_IN_SECRET_MANAGER_ONLY

# Wise — payout / international transfer rail (not recurring SaaS checkout).
WISE_ENVIRONMENT=sandbox
WISE_API_TOKEN=REPLACE_IN_SECRET_MANAGER_ONLY
WISE_PROFILE_ID=REPLACE_ME
# Wise RSA public key used to verify X-Signature-SHA256 webhooks.
# Store multiline PEM safely in the deployment secret manager; escaped \n is accepted.
WISE_WEBHOOK_PUBLIC_KEY=REPLACE_IN_SECRET_MANAGER_ONLY

# Deterministic sequence validation worker
GENITHM_SEQUENCE_VISIBILITY_SECONDS=300
GENITHM_SEQUENCE_MAX_ATTEMPTS=3
GENITHM_SEQUENCE_POLL_SECONDS=2

# NCBI scientific source worker
NCBI_TOOL=genithm
NCBI_EMAIL=developer-contact@example.com
NCBI_API_KEY=
GENITHM_NCBI_VISIBILITY_SECONDS=300
GENITHM_NCBI_MAX_ATTEMPTS=3
GENITHM_NCBI_POLL_SECONDS=2

# NCBI BLAST worker
GENITHM_BLAST_VISIBILITY_SECONDS=300
GENITHM_BLAST_POLL_SECONDS=2

# Generic deterministic scientific worker (Pairwise Alignment V1)
GENITHM_SCIENTIFIC_VISIBILITY_SECONDS=300
GENITHM_SCIENTIFIC_MAX_ATTEMPTS=3
GENITHM_SCIENTIFIC_POLL_SECONDS=2

# Tamper-evident audit checkpoint signer
GENITHM_AUDIT_SIGNING_KEY_ID=audit-ed25519-prod-v1
GENITHM_AUDIT_SIGNING_PRIVATE_KEY_BASE64=REPLACE_IN_SECRET_MANAGER_ONLY
GENITHM_AUDIT_VISIBILITY_SECONDS=300
GENITHM_AUDIT_POLL_SECONDS=2
