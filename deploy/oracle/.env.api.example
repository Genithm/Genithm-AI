# Copy to deploy/oracle/.env.api on the Oracle API host. Never commit the real file.

# Immutable GHCR image reference, for example:
# ghcr.io/genithm/genithm-api@sha256:<64-hex-digest>
GENITHM_API_IMAGE=ghcr.io/genithm/genithm-api@sha256:REPLACE_WITH_64_HEX_DIGEST

# Immutable Cloudflare Tunnel image reference. Resolve and pin a current official cloudflared digest before deployment.
GENITHM_CLOUDFLARED_IMAGE=cloudflare/cloudflared@sha256:REPLACE_WITH_64_HEX_DIGEST

# Remotely managed Cloudflare Tunnel token. Runtime-only secret; never commit it or pass it in process arguments.
GENITHM_CLOUDFLARE_TUNNEL_TOKEN=REPLACE_ME

# Browser origin allowed to call the API, normally the production Vercel domain.
GENITHM_API_ALLOWED_ORIGINS=https://REPLACE_WITH_FRONTEND_DOMAIN

# Supabase. Publishable key is used only to validate/forward user JWT requests;
# the secret key remains backend-only and must never enter NEXT_PUBLIC_* variables.
SUPABASE_URL=https://REPLACE_WITH_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Cloudflare R2 S3-compatible endpoint and server-side credentials.
# Example endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
GENITHM_R2_ENDPOINT=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
GENITHM_R2_ACCESS_KEY_ID=REPLACE_ME
GENITHM_R2_SECRET_ACCESS_KEY=REPLACE_ME
GENITHM_R2_SEQUENCE_BUCKET=genithm-sequence-inputs
GENITHM_STORAGE_SIGNED_URL_SECONDS=300

# Host loopback port used only for local health checks and break-glass debugging.
GENITHM_API_HOST_PORT=8000
