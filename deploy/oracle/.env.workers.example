# Copy to .env.workers on the Oracle worker host and replace placeholders locally.
# Never commit the real .env.workers file.

SUPABASE_URL=https://REPLACE_ME.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
NCBI_EMAIL=researcher@example.com
NCBI_API_KEY=

# Cloudflare R2 credentials are required by the sequence worker for new R2-backed inputs.
# Legacy Supabase Storage inputs remain readable during migration.
GENITHM_R2_ENDPOINT=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
GENITHM_R2_ACCESS_KEY_ID=REPLACE_ME
GENITHM_R2_SECRET_ACCESS_KEY=REPLACE_ME
GENITHM_R2_SEQUENCE_BUCKET=genithm-sequence-inputs

# V1 locked provider order: Qwen primary, DeepSeek backup.
# Endpoint/model selection remains deployment configuration so providers stay replaceable.
GENITHM_AI_PRIMARY_PROVIDER=qwen
GENITHM_AI_PRIMARY_API_KEY=REPLACE_ME
GENITHM_AI_PRIMARY_ENDPOINT=https://REPLACE_ME
GENITHM_AI_PRIMARY_MODEL=REPLACE_ME
GENITHM_AI_PRIMARY_PROTOCOL=chat_completions

GENITHM_AI_BACKUP_ENABLED=true
GENITHM_AI_BACKUP_PROVIDER=deepseek
GENITHM_AI_BACKUP_API_KEY=REPLACE_ME
GENITHM_AI_BACKUP_ENDPOINT=https://REPLACE_ME
GENITHM_AI_BACKUP_MODEL=REPLACE_ME
GENITHM_AI_BACKUP_PROTOCOL=chat_completions

GENITHM_AUDIT_SIGNING_KEY_ID=REPLACE_ME
GENITHM_AUDIT_SIGNING_PRIVATE_KEY_BASE64=REPLACE_ME

# Every image must be an immutable digest-pinned multi-architecture release image.
GENITHM_SEQUENCE_WORKER_IMAGE=ghcr.io/genithm/genithm-sequence-worker@sha256:REPLACE_ME
GENITHM_SOURCE_WORKER_IMAGE=ghcr.io/genithm/genithm-source-worker@sha256:REPLACE_ME
GENITHM_BLAST_WORKER_IMAGE=ghcr.io/genithm/genithm-blast-worker@sha256:REPLACE_ME
GENITHM_SCIENTIFIC_WORKER_IMAGE=ghcr.io/genithm/genithm-scientific-worker@sha256:REPLACE_ME
GENITHM_AUDIT_WORKER_IMAGE=ghcr.io/genithm/genithm-audit-worker@sha256:REPLACE_ME
GENITHM_AI_WORKER_IMAGE=ghcr.io/genithm/genithm-ai-worker@sha256:REPLACE_ME
